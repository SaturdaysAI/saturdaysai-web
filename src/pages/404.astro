---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/content';
import Icon from '../components/Icon.astro';
---

<Layout title="A little off the path">
  <section class="container section">
    <span class="eyebrow">404 / A LITTLE OFF THE PATH</span>
    <h1 class="mt-20">
      Curiosity takes you
      <br />
      <span class="orange-word">places.</span>
    </h1>
    <p class="mt-20">We couldn’t find this page. Search the archive or explore the community.</p>
    <form
      class="recovery-search mt-20"
      action={url('/blog-y-noticias/')}
      method="get"
      role="search"
    >
      <label for="recovery-query">Find a story, project or topic</label>
      <input
        id="recovery-query"
        name="q"
        type="search"
        placeholder="What were you looking for?"
        required
      />
      <button class="button button-dark" type="submit">
        Search stories <Icon name="search" size={18} />
      </button>
    </form>
    <a class="text-link mt-20" href={url('/explore/')}>
      Explore all resources <Icon name="arrow" />
    </a>
  </section>
</Layout>
