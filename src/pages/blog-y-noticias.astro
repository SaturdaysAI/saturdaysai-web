---
import Layout from '../layouts/Layout.astro';
import FilterStatus from '../components/FilterStatus.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { publishedPosts, url } from '../lib/content';
const posts = await publishedPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
const featured = posts[0];
---

<Layout
  title="Stories, experiments & ideas"
  description="Stories from the Saturdays.AI community. Explore AI tutorials, real projects and ideas with social impact."
>
  <div class="container">
    <section class="page-hero">
      <span class="eyebrow">THE SATURDAYS JOURNAL</span>
      <h1>
        Good ideas
        <br />
        are worth <span class="orange-word">sharing.</span>
      </h1>
      <p>
        Experiments, lessons and stories from people putting AI into practice. Written by our
        community, in their own words.
      </p>
    </section>
    <div class="listing-tools" data-filters>
      <div class="filter-pills" aria-label="Filter stories by topic">
        {['All stories', 'Community', 'AI for good', 'Build with AI', 'Podcast'].map((c, i) => (
          <button
            data-filter={i === 0 ? 'all' : c}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class:list={{ selected: i === 0 }}
          >
            {c}
          </button>
        ))}
      </div>
      <label class="search-box">
        <Icon name="search" size={18} />
        <span class="sr-only">Search stories</span>
        <input type="search" placeholder="Search stories, topics, authors…" data-search-input />
      </label>
    </div>
    <label class="sr-only" for="year">
      Filter by year
    </label>
    <select id="year" data-year class="filter-select" aria-label="Filter by year">
      <option value="">All years</option>
      {years.map((year) => (
        <option value={year}>{year}</option>
      ))}
    </select>
    <FilterStatus text={`${posts.length} stories to explore.`} />
    {featured && (
      <a class="featured-story" data-featured href={url(featured.data.legacyPath)}>
        <ResponsiveImage
          src={featured.data.image || '/social-card.png'}
          alt={featured.data.imageAlt}
          width={720}
          height={450}
          sizes="(max-width: 580px) 86px, (max-width: 800px) 90vw, 580px"
        />
        <div>
          <span class="eyebrow">THE LATEST FROM OUR COMMUNITY</span>
          <h2 lang={featured.data.language}>{featured.data.title}</h2>
          <p lang={featured.data.language}>{featured.data.description}</p>
          <span class="text-link">
            Read the story <Icon name="arrow" size={18} />
          </span>
        </div>
      </a>
    )}

    <noscript>
      <p class="no-js-note">
        All stories are shown below. Search and topic filters require JavaScript.
      </p>
    </noscript>
    <div class="post-grid listing-grid">
      {posts.map((post) => (
        <PostCard post={post} heading="h2" />
      ))}
    </div>
    <div class="load-more-wrap">
      <button class="button button-dark" data-load-more hidden>
        Show more stories
      </button>
    </div>
    <div class="empty-state" data-empty hidden>
      <Icon name="search" size={30} />
      <h2>No stories found.</h2>
      <p>Try a different word or explore another topic.</p>
      <button class="button button-dark" data-reset>
        Show all stories
      </button>
    </div>
  </div>
  <script>
    import { setupFilters } from '../scripts/filters';
    setupFilters({ item: '[data-post]', noun: 'stories', suffix: '' });
  </script>
</Layout>
