---
import Layout from '../layouts/Layout.astro';
import SectionArchive from '../components/SectionArchive.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/content';
import cities from '../data/cities.json';
import site from '../data/site.json';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { breadcrumbSchema, structuredJSON } from '../lib/seo.mjs';
export function getStaticPaths() {
  return cities.cities
    .filter((c) => !c.draft)
    .map((city) => ({ params: { city: city.slug }, props: { city } }));
}
const { city } = Astro.props;
const emblem = !city.logo || city.image === city.logo;
const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: new URL(url('/'), Astro.site).href },
  { name: 'Community', url: new URL(url('/cities/'), Astro.site).href },
  { name: city.name, url: new URL(url(`/${city.slug}/`), Astro.site).href },
]);
---

<Layout
  title={`AI Saturdays ${city.name}`}
  description={city.description}
  image={city.image || site.communityImage}
>
  <script slot="head" type="application/ld+json" set:html={structuredJSON(breadcrumbs)} />
  <div class="container">
    <section class="page-hero pb-0">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={url('/cities/')}>Community</a>
        <span aria-hidden="true">/</span>
        <span>{city.name}</span>
      </nav>
    </section>
    <section class="city-intro">
      <div>
        <span class="eyebrow">{city.country.toUpperCase()} / AI SATURDAYS</span>
        {city.logo && (
          <img
            class="city-brand"
            src={url(city.logo)}
            alt={`AI Saturdays ${city.name}`}
            width="250"
            height="160"
          />
        )}
        <h1>
          Hello,
          <br />
          <span class="orange-word">{city.name}.</span>
        </h1>
        <p>{city.description}</p>
        <a class="button button-orange" href={city.contact}>
          Connect with the team <Icon name="northeast" size={18} />
        </a>
      </div>
      <ResponsiveImage
        src={city.image || site.communityImage}
        alt={`AI Saturdays ${city.name}`}
        class={emblem ? 'city-emblem' : undefined}
        sizes="(max-width: 800px) 90vw, 550px"
        loading="eager"
        fetchpriority="high"
      />
    </section>
    <div class="status-note">
      <span class="status-dot"></span>
      <span>
        {city.status}. Dates, location and programme details are confirmed by the local team.
      </span>
    </div>
    <div class="info-columns">
      <div>
        <Icon name="book" size={28} />
        <h2>Learn by doing</h2>
        <p>
          Bring your curiosity and develop your skills through practical work, shared questions and
          community learning.
        </p>
      </div>
      <div>
        <Icon name="code" size={28} />
        <h2>Build for social good</h2>
        <p>
          Explore how AI can address real challenges. Turn what you learn into a project with a
          purpose.
        </p>
      </div>
      <div>
        <Icon name="users" size={28} />
        <h2>Grow together</h2>
        <p>
          Connect with learners and mentors from different backgrounds. Share ideas and support each
          other along the way.
        </p>
      </div>
    </div>
    <section class="closing-section">
      <span class="eyebrow">KEEP YOUR CURIOSITY MOVING</span>
      <h2>Your learning starts wherever you are.</h2>
      <p>Explore our online learning paths while you connect with your local community.</p>
      <a class="button button-dark" href={url('/online/')}>
        Explore the courses <Icon name="arrow" size={18} />
      </a>
    </section>
  </div>
  <div class="container">
    <SectionArchive path={'/' + city.slug + '/'} label="Local community archive and resources" />
  </div>
</Layout>
