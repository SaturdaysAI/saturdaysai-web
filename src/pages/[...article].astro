---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts, url, dateLabel, readingTime } from '../lib/content';
import { renderContent } from '../lib/render-content';
import { getCollection } from 'astro:content';
import ContentPage from '../components/ContentPage.astro';
import ArchivePage from '../components/ArchivePage.astro';
import taxonomies from '../data/taxonomies.json';
import comments from '../data/comments.json';
import cities from '../data/cities.json';
import { assertDistinctRoutes } from '../lib/content-rules.mjs';
export async function getStaticPaths() {
  const posts = (await publishedPosts()).map((post) => ({
    params: { article: post.data.legacyPath.slice(1, -1) },
    props: { post, page: null, archive: null },
  }));
  const pages = (await getCollection('pages'))
    .filter((p) => !p.data.draft && p.data.kind === 'page')
    .map((page) => ({
      params: { article: page.data.legacyPath.slice(1, -1) },
      props: { page, post: null, archive: null },
    }));
  const archives = taxonomies.map((archive) => ({
    params: { article: archive.path.slice(1, -1) },
    props: { archive, post: null, page: null },
  }));
  const routes = [...posts, ...pages, ...archives];
  assertDistinctRoutes([
    ...routes.map((route) => `/${route.params.article}/`),
    ...cities.cities.filter((city) => !city.draft).map((city) => `/${city.slug}/`),
    '/cities/',
    '/online/',
    '/proyectos/',
    '/blog-y-noticias/',
    '/podcast/',
    '/explore/',
    '/admin/',
  ]);
  return routes;
}
const { post, page, archive } = Astro.props;
const p = post?.data;
const all = await publishedPosts();
const related = post
  ? all.filter((x) => x.id !== post.id && x.data.category === post.data.category).slice(0, 3)
  : [];
const { html, toc } = await renderContent(post?.body || '');
const archivedComments = comments.filter((c) => c.postId === p?.sourceId);
const initials = (p?.author || '')
  .split(' ')
  .slice(0, 2)
  .map((x) => x[0])
  .join('');
const copy = {
  en: {
    breadcrumb: 'Breadcrumb',
    home: 'Home',
    projects: 'Projects',
    blog: 'Blog & news',
    minutes: 'min read',
    contents: 'In this article',
    tools: 'Reading tools',
    copy: 'Copy link',
    success: 'Link copied.',
    error: 'Copy the address from your browser.',
    comments: 'Archived comments',
    origin: 'A story from the Saturdays.AI community. Originally published on',
    more: 'More community stories',
    explore: 'KEEP EXPLORING',
    related: 'More ideas from the community.',
  },
  es: {
    breadcrumb: 'Ruta de navegación',
    home: 'Inicio',
    projects: 'Proyectos',
    blog: 'Blog y noticias',
    minutes: 'min de lectura',
    contents: 'En este artículo',
    tools: 'Herramientas de lectura',
    copy: 'Copiar enlace',
    success: 'Enlace copiado.',
    error: 'Copia la dirección desde tu navegador.',
    comments: 'Comentarios del archivo',
    origin: 'Una historia de la comunidad Saturdays.AI. Publicada originalmente el',
    more: 'Más historias de la comunidad',
    explore: 'SIGUE EXPLORANDO',
    related: 'Más ideas de la comunidad.',
  },
  pt: {
    breadcrumb: 'Navegação',
    home: 'Início',
    projects: 'Projetos',
    blog: 'Blog e notícias',
    minutes: 'min de leitura',
    contents: 'Neste artigo',
    tools: 'Ferramentas de leitura',
    copy: 'Copiar ligação',
    success: 'Ligação copiada.',
    error: 'Copie o endereço do seu navegador.',
    comments: 'Comentários do arquivo',
    origin: 'Uma história da comunidade Saturdays.AI. Publicada originalmente em',
    more: 'Mais histórias da comunidade',
    explore: 'CONTINUE A EXPLORAR',
    related: 'Mais ideias da comunidade.',
  },
}[p?.language || 'en'];
const structured = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p?.title,
  description: p?.description,
  datePublished: p?.pubDate.toISOString(),
  author: { '@type': p?.author === 'Saturdays.AI' ? 'Organization' : 'Person', name: p?.author },
  publisher: { '@type': 'Organization', name: 'Saturdays.AI' },
  inLanguage: p?.language,
  mainEntityOfPage: new URL(url(p?.legacyPath || '/'), Astro.site).href,
  ...(p?.image ? { image: new URL(url(p.image), Astro.site).href } : {}),
};
---

{page ? (
  <ContentPage page={page} />
) : archive ? (
  <ArchivePage archive={archive} />
) : (
  post &&
  p && (
    <Layout
      title={p.title}
      description={p.description}
      image={p.image || '/social-card.png'}
      language={p.language}
      article
    >
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
      />
      <div class="reading-progress" aria-hidden="true"></div>
      <article>
        <header class="container article-header">
          <nav class="breadcrumb" aria-label={copy.breadcrumb}>
            <a href={url('/')}>{copy.home}</a>
            <span aria-hidden="true">/</span>
            <a href={url(p.kind === 'project' ? '/proyectos/' : '/blog-y-noticias/')}>
              {p.kind === 'project' ? copy.projects : copy.blog}
            </a>
            <span aria-hidden="true">/</span>
            <span>{p.category}</span>
          </nav>
          <div class="post-meta">
            <span class="tag">{p.category}</span>
            <span>
              {readingTime(post.body)} {copy.minutes}
            </span>
            <span>{{ es: 'Español', en: 'English', pt: 'Português' }[p.language]}</span>
          </div>
          <h1>{p.title}</h1>
          <p class="article-deck">{p.description}</p>
          <div class="article-author">
            <span class="author-avatar" aria-hidden="true">
              {initials}
            </span>
            <div>
              <strong>{p.author}</strong>
              <time datetime={p.pubDate.toISOString()}>{dateLabel(p.pubDate, p.language)}</time>
            </div>
          </div>
        </header>
        {p.image && (
          <figure class="container article-cover">
            <img
              src={url(p.image)}
              alt={p.imageAlt || p.title}
              width="1440"
              height="900"
              fetchpriority="high"
            />
          </figure>
        )}
        <div class="container article-shell">
          <aside class="article-aside reading-navigation" aria-label={copy.tools}>
            <TableOfContents items={toc} label={copy.contents} />
            <button
              class="button button-outline"
              data-copy-link
              data-success={copy.success}
              data-error={copy.error}
            >
              <Icon name="copy" size={16} />
              {copy.copy}
            </button>
            <span class="copy-status" role="status" data-copy-status></span>
          </aside>
          <div class="reading-body">
            <div class="prose" set:html={html} />
            {archivedComments.length > 0 && (
              <section class="archived-comments">
                <h2>{copy.comments}</h2>
                {archivedComments.map((c) => (
                  <blockquote id={`comment-${c.id}`}>
                    <p>{c.body}</p>
                    <footer>
                      {c.author} — <time datetime={c.date}>{c.date.slice(0, 10)}</time>
                    </footer>
                  </blockquote>
                ))}
              </section>
            )}
            <div class="article-end">
              <p>
                {copy.origin} {dateLabel(p.pubDate, p.language)}.
              </p>
              <a href={url('/blog-y-noticias/')}>← {copy.more}</a>
            </div>
          </div>
        </div>
      </article>
      {related.length > 0 && (
        <section class="container related-section">
          <div class="section-heading">
            <div>
              <span class="eyebrow">{copy.explore}</span>
              <h2>{copy.related}</h2>
            </div>
          </div>
          <div class="post-grid">
            {related.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )}
      <script>
        const progress = document.querySelector<HTMLElement>('.reading-progress');
        const update = () => {
          if (progress) {
            const body = document.querySelector('.reading-body');
            if (!body) return;
            const box = body.getBoundingClientRect();
            const start = box.top + scrollY - 120;
            const distance = Math.max(1, box.height - innerHeight + 120);
            progress.style.width = `${Math.max(0, Math.min(100, ((scrollY - start) / distance) * 100))}%`;
          }
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        const readingBody = document.querySelector('.reading-body');
        if (readingBody) new ResizeObserver(update).observe(readingBody);
        update();
        const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
        copyButton?.addEventListener('click', async () => {
          const status = document.querySelector('[data-copy-status]');
          if (status) status.textContent = `${copyButton.textContent?.trim()}…`;
          copyButton.disabled = true;
          let timeout: ReturnType<typeof setTimeout> | undefined;
          try {
            await Promise.race([
              navigator.clipboard.writeText(location.href),
              new Promise<never>((_, reject) => {
                timeout = setTimeout(() => reject(new Error('Clipboard unavailable')), 3000);
              }),
            ]);
            if (status) status.textContent = copyButton.dataset.success || '';
          } catch {
            if (status) status.textContent = copyButton.dataset.error || '';
          } finally {
            clearTimeout(timeout);
            copyButton.disabled = false;
          }
        });
      </script>
    </Layout>
  )
)}
