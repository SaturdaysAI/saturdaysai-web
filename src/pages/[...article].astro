---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostCard from '../components/PostCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import MediaPlayer from '../components/MediaPlayer.astro';
import NextSteps from '../components/NextSteps.astro';
import { findMedia, episodeInfo } from '../lib/media.mjs';
import { relatedPosts } from '../lib/recommendations.mjs';
import { breadcrumbSchema, structuredJSON } from '../lib/seo.mjs';
import { publishedPosts, url, dateLabel, readingTime } from '../lib/content';
import { renderContent } from '../lib/render-content';
import { getCollection, type CollectionEntry } from 'astro:content';
import ContentPage from '../components/ContentPage.astro';
import ArchivePage from '../components/ArchivePage.astro';
import taxonomies from '../data/taxonomies.json';
import comments from '../data/comments.json';
import cities from '../data/cities.json';
import { assertDistinctRoutes } from '../lib/content-rules.mjs';
export async function getStaticPaths() {
  const posts = (await publishedPosts()).map((post) => ({
    params: { article: post.data.legacyPath.slice(1, -1) },
    props: { post, page: null, archive: null },
  }));
  const pages = (await getCollection('pages'))
    .filter((p) => !p.data.draft && p.data.kind === 'page')
    .map((page) => ({
      params: { article: page.data.legacyPath.slice(1, -1) },
      props: { page, post: null, archive: null },
    }));
  const archives = taxonomies.map((archive) => ({
    params: { article: archive.path.slice(1, -1) },
    props: { archive, post: null, page: null },
  }));
  const routes = [...posts, ...pages, ...archives];
  assertDistinctRoutes([
    ...routes.map((route) => `/${route.params.article}/`),
    ...cities.cities.filter((city) => !city.draft).map((city) => `/${city.slug}/`),
    '/cities/',
    '/online/',
    '/proyectos/',
    '/blog-y-noticias/',
    '/podcast/',
    '/explore/',
    '/admin/',
  ]);
  return routes;
}
const { post, page, archive } = Astro.props;
const p = post?.data;
const all = await publishedPosts();
const isPodcast = p?.category === 'Podcast';
const episode = episodeInfo(p?.title);
const media = isPodcast ? findMedia(post?.body) : null;
const sectionPath = isPodcast
  ? '/podcast/'
  : p?.kind === 'project'
    ? '/proyectos/'
    : '/blog-y-noticias/';
const related: CollectionEntry<'posts'>[] = post ? relatedPosts(post, all) : [];
const { html, toc } = await renderContent(post?.body || '', false, p?.image || '');
const archivedComments = comments.filter((c) => c.postId === p?.sourceId);
const initials = (p?.author || '')
  .split(' ')
  .slice(0, 2)
  .map((x) => x[0])
  .join('');
const copy = {
  en: {
    breadcrumb: 'Breadcrumb',
    home: 'Home',
    projects: 'Projects',
    blog: 'Blog & news',
    minutes: 'min read',
    contents: 'In this article',
    tools: 'Reading tools',
    copy: 'Copy link',
    success: 'Link copied.',
    error: 'Copy the address from your browser.',
    comments: 'Archived comments',
    origin: 'A story from the Saturdays.AI community. Originally published on',
    more: 'More community stories',
    explore: 'KEEP EXPLORING',
    related: 'More ideas from the community.',
  },
  es: {
    breadcrumb: 'Ruta de navegación',
    home: 'Inicio',
    projects: 'Proyectos',
    blog: 'Blog y noticias',
    minutes: 'min de lectura',
    contents: 'En este artículo',
    tools: 'Herramientas de lectura',
    copy: 'Copiar enlace',
    success: 'Enlace copiado.',
    error: 'Copia la dirección desde tu navegador.',
    comments: 'Comentarios del archivo',
    origin: 'Una historia de la comunidad Saturdays.AI. Publicada originalmente el',
    more: 'Más historias de la comunidad',
    explore: 'SIGUE EXPLORANDO',
    related: 'Más ideas de la comunidad.',
  },
  pt: {
    breadcrumb: 'Navegação',
    home: 'Início',
    projects: 'Projetos',
    blog: 'Blog e notícias',
    minutes: 'min de leitura',
    contents: 'Neste artigo',
    tools: 'Ferramentas de leitura',
    copy: 'Copiar ligação',
    success: 'Ligação copiada.',
    error: 'Copie o endereço do seu navegador.',
    comments: 'Comentários do arquivo',
    origin: 'Uma história da comunidade Saturdays.AI. Publicada originalmente em',
    more: 'Mais histórias da comunidade',
    explore: 'CONTINUE A EXPLORAR',
    related: 'Mais ideias da comunidade.',
  },
}[p?.language || 'en'];
const sectionName = isPodcast ? 'Podcast' : p?.kind === 'project' ? copy.projects : copy.blog;
const absolute = (path: string) => new URL(url(path), Astro.site).href;
const structured = {
  '@context': 'https://schema.org',
  '@type': isPodcast ? 'PodcastEpisode' : 'BlogPosting',
  '@id': `${absolute(p?.legacyPath || '/')}#article`,
  name: p?.title,
  headline: p?.title,
  description: p?.description,
  datePublished: p?.pubDate.toISOString(),
  author: { '@type': p?.author === 'Saturdays.AI' ? 'Organization' : 'Person', name: p?.author },
  publisher: { '@id': `${absolute('/')}#organization` },
  inLanguage: p?.language,
  mainEntityOfPage: { '@id': `${absolute(p?.legacyPath || '/')}#webpage` },
  ...(p?.updatedDate ? { dateModified: p.updatedDate.toISOString() } : {}),
  ...(isPodcast
    ? {
        partOfSeries: {
          '@type': 'PodcastSeries',
          name: 'Saturdays.AI Podcast',
          url: absolute('/podcast/'),
        },
        ...(episode
          ? {
              episodeNumber: episode.episode,
              partOfSeason: { '@type': 'PodcastSeason', seasonNumber: episode.season },
            }
          : {}),
      }
    : {}),
  ...(p?.image ? { image: new URL(url(p.image), Astro.site).href } : {}),
};
const breadcrumbs = breadcrumbSchema([
  { name: copy.home, url: absolute('/') },
  { name: sectionName, url: absolute(sectionPath) },
  { name: p?.title, url: absolute(p?.legacyPath || '/') },
]);
---

{page ? (
  <ContentPage page={page} />
) : archive ? (
  <ArchivePage archive={archive} />
) : (
  post &&
  p && (
    <Layout
      title={p.title}
      description={p.description}
      image={p.image || '/social-card.png'}
      imageAlt={p.imageAlt || p.title}
      language={p.language}
      article
    >
      <Fragment slot="head">
        <script type="application/ld+json" set:html={structuredJSON([structured, breadcrumbs])} />
        <meta property="article:published_time" content={p.pubDate.toISOString()} />
        {p.updatedDate && (
          <meta property="article:modified_time" content={p.updatedDate.toISOString()} />
        )}
        <meta property="article:author" content={p.author} />
      </Fragment>
      <div class="reading-progress" aria-hidden="true"></div>
      <article>
        <header class:list={['container', 'article-header', { 'podcast-header': isPodcast }]}>
          <nav class="breadcrumb" aria-label={copy.breadcrumb}>
            <a href={url('/')}>{copy.home}</a>
            <span aria-hidden="true">/</span>
            <a href={url(sectionPath)}>{sectionName}</a>
            <span aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">
              {p.title}
            </span>
          </nav>
          <div class="post-meta">
            <span class="tag">{p.category}</span>
            <span>
              {isPodcast
                ? episode
                  ? `T${episode.season} / E${episode.episode}`
                  : 'Podcast'
                : `${readingTime(post.body)} ${copy.minutes}`}
            </span>
            <span>{{ es: 'Español', en: 'English', pt: 'Português' }[p.language]}</span>
          </div>
          <h1>{p.title}</h1>
          <p class="article-deck">{p.description}</p>
          {isPodcast && (
            <div class="episode-intro">
              {p.image && (
                <ResponsiveImage
                  src={p.image}
                  alt={p.imageAlt || p.title}
                  sizes="(max-width: 580px) 96px, 200px"
                  loading="eager"
                  class="episode-art"
                />
              )}
              {media ? (
                <MediaPlayer media={media} language={p.language} id="episode-player" />
              ) : (
                <a class="button button-dark" href="#episode-notes">
                  {
                    {
                      es: 'Ver enlaces del episodio',
                      pt: 'Ver ligações do episódio',
                      en: 'Explore the episode',
                    }[p.language]
                  }{' '}
                  ↓
                </a>
              )}
            </div>
          )}
          <div class="article-author">
            <span class="author-avatar" aria-hidden="true">
              {initials}
            </span>
            <div>
              <strong>{p.author}</strong>
              <time datetime={p.pubDate.toISOString()}>{dateLabel(p.pubDate, p.language)}</time>
              {p.updatedDate && (
                <span class="updated-date">
                  {{ es: 'Actualizado', pt: 'Atualizado', en: 'Updated' }[p.language]}{' '}
                  <time datetime={p.updatedDate.toISOString()}>
                    {dateLabel(p.updatedDate, p.language)}
                  </time>
                </span>
              )}
            </div>
          </div>
        </header>
        {p.image && !isPodcast && (
          <figure class="container article-cover">
            <ResponsiveImage
              src={p.image}
              alt={p.imageAlt || p.title}
              sizes="(max-width: 1200px) 92vw, 1100px"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )}
        <div class="container article-shell">
          <aside class="article-aside reading-navigation" aria-label={copy.tools}>
            <TableOfContents items={toc} label={copy.contents} />
            <button
              class="button button-outline"
              data-copy-link
              data-success={copy.success}
              data-error={copy.error}
            >
              <Icon name="copy" size={16} />
              {copy.copy}
            </button>
            <span class="copy-status" role="status" data-copy-status></span>
          </aside>
          <div class="reading-body">
            <div class="prose" id={isPodcast ? 'episode-notes' : undefined} set:html={html} />
            {archivedComments.length > 0 && (
              <section class="archived-comments">
                <h2>{copy.comments}</h2>
                {archivedComments.map((c) => (
                  <blockquote id={`comment-${c.id}`}>
                    <p>{c.body}</p>
                    <footer>
                      {c.author} — <time datetime={c.date}>{c.date.slice(0, 10)}</time>
                    </footer>
                  </blockquote>
                ))}
              </section>
            )}
            {p.tags.length > 0 && (
              <nav
                class="article-topics"
                aria-label={
                  {
                    es: 'Explora estos temas',
                    pt: 'Explore estes temas',
                    en: 'Explore these topics',
                  }[p.language]
                }
              >
                {p.tags.slice(0, 6).map((tag: string) => (
                  <a href={`${url('/blog-y-noticias/')}?q=${encodeURIComponent(tag)}`}>
                    {tag} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </nav>
            )}
            <NextSteps language={p.language} podcast={isPodcast} />
            <div class="article-end">
              <p>
                {copy.origin} {dateLabel(p.pubDate, p.language)}.
              </p>
              <a href={url(sectionPath)}>← {isPodcast ? 'Podcast' : copy.more}</a>
            </div>
          </div>
        </div>
      </article>
      {related.length > 0 && (
        <section class="container related-section">
          <div class="section-heading">
            <div>
              <span class="eyebrow">{copy.explore}</span>
              <h2>{copy.related}</h2>
            </div>
          </div>
          <div class="post-grid">
            {related.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )}
      <script>
        const progress = document.querySelector<HTMLElement>('.reading-progress');
        const update = () => {
          if (progress) {
            const body = document.querySelector('.reading-body');
            if (!body) return;
            const box = body.getBoundingClientRect();
            const start = box.top + scrollY - 120;
            const distance = Math.max(1, box.height - innerHeight + 120);
            progress.style.width = `${Math.max(0, Math.min(100, ((scrollY - start) / distance) * 100))}%`;
          }
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        const readingBody = document.querySelector('.reading-body');
        if (readingBody) new ResizeObserver(update).observe(readingBody);
        update();
        const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
        copyButton?.addEventListener('click', async () => {
          const status = document.querySelector('[data-copy-status]');
          if (status) status.textContent = `${copyButton.textContent?.trim()}…`;
          copyButton.disabled = true;
          let timeout: ReturnType<typeof setTimeout> | undefined;
          try {
            await Promise.race([
              navigator.clipboard.writeText(location.href),
              new Promise<never>((_, reject) => {
                timeout = setTimeout(() => reject(new Error('Clipboard unavailable')), 3000);
              }),
            ]);
            if (status) status.textContent = copyButton.dataset.success || '';
          } catch {
            if (status) status.textContent = copyButton.dataset.error || '';
          } finally {
            clearTimeout(timeout);
            copyButton.disabled = false;
          }
        });
      </script>
    </Layout>
  )
)}
