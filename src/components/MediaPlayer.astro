---
interface Props {
  media: { name: string; audio: boolean; src: string };
  language?: string;
  id?: string;
}
const { media, language = 'en', id } = Astro.props;
const text =
  language === 'es'
    ? {
        play: media.audio ? 'Escuchar episodio' : 'Ver episodio',
        note: `Reproductor de ${media.name}. Se carga cuando lo activas.`,
        open: `Abrir en ${media.name}`,
      }
    : language === 'pt'
      ? {
          play: media.audio ? 'Ouvir episódio' : 'Ver episódio',
          note: `O leitor de ${media.name} carrega ao iniciar.`,
          open: `Abrir em ${media.name}`,
        }
      : {
          play: media.audio ? 'Listen to the episode' : 'Watch the episode',
          note: `The ${media.name} player loads when you start.`,
          open: `Open on ${media.name}`,
        };
---

<div
  class="media-panel"
  data-player
  data-provider={media.name}
  data-audio={String(media.audio)}
  data-source={media.src}
  id={id}
  lang={language}
>
  <button class="button button-dark" type="button" data-play hidden>
    <span aria-hidden="true">▶</span>
    {text.play}
  </button>
  <p data-player-note>{text.note}</p>
  <a class="text-link" href={media.src}>
    {text.open} <span aria-hidden="true">↗</span>
  </a>
</div>
