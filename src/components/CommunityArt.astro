---
import { url } from '../lib/content';
import site from '../data/site.json';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
---

<div class="community-art" aria-label="A community built around learning and creating together">
  <div class="art-grid" aria-hidden="true"></div>
  <div class="orbit orbit-one" aria-hidden="true"></div>
  <div class="orbit orbit-two" aria-hidden="true"></div>
  <div class="art-label eyebrow">
    <span class="status-dot"></span> Curiosity connects us
  </div>
  <div class="art-photo">
    <ResponsiveImage
      src={site.heroImage}
      alt="Saturdays.AI community members learning together"
      width={620}
      height={600}
      fetchpriority="high"
      loading="eager"
      sizes="(max-width: 580px) 85vw, 500px"
    />
    <span class="photo-caption">
      <span class="status-dot"></span> Real people. Shared curiosity.
    </span>
  </div>
  <div class="art-code" aria-hidden="true">
    <span class="code-window">
      <i></i>
      <i></i>
      <i></i>
      <span>hello_future.py</span>
    </span>
    <code>
      <span class="code-purple">while</span> curious:
      <br />
      &nbsp; learn()
      <br />
      &nbsp; build()
      <br />
      &nbsp; <span class="code-orange">share()</span>
    </code>
  </div>
  <div class="art-sticker" aria-hidden="true">
    <img src={url('/brand/network.svg')} width="52" height="52" alt="" />
    <span>
      AI4ALL.
      <br />
      AI4GOOD.
    </span>
  </div>
  <div class="art-note">
    <Icon name="users" size={22} />
    <div>
      <strong>Find your people.</strong>
      <span>Build something bigger.</span>
    </div>
  </div>
  <svg class="art-connector" viewBox="0 0 500 500" aria-hidden="true">
    <path
      d="M45 130C140 30 360 20 455 145S470 420 280 450 20 380 40 250"
      fill="none"
      stroke="#0b6099"
      stroke-width="1"
      stroke-dasharray="5 8"
    />
    <circle cx="450" cy="145" r="5" fill="#ff9d5a" />
    <circle cx="40" cy="250" r="5" fill="#ff9d5a" />
  </svg>
</div>
