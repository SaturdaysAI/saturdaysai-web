<script>
  import { mediaProvider } from '../lib/media.mjs';
  const lang = document.documentElement.lang;
  const text =
    lang === 'es'
      ? {
          audio: 'Escuchar audio',
          video: 'Ver vídeo',
          open: 'Abrir en',
          note: 'El reproductor externo se carga al activarlo.',
          loaded: 'Si el reproductor no carga, abre el enlace original.',
          above: 'Ir al reproductor del episodio ↑',
        }
      : lang === 'pt'
        ? {
            audio: 'Ouvir áudio',
            video: 'Ver vídeo',
            open: 'Abrir em',
            note: 'O leitor externo carrega ao iniciar.',
            loaded: 'Se o leitor não carregar, abra a ligação original.',
            above: 'Ir para o leitor do episódio ↑',
          }
        : {
            audio: 'Play audio',
            video: 'Play video',
            open: 'Open on',
            note: 'The external player loads when you start.',
            loaded: 'If the player does not load, open the original link.',
            above: 'Go to the episode player ↑',
          };
  function activate(panel: HTMLElement) {
    const button = panel.querySelector<HTMLButtonElement>('[data-play]');
    const provider = mediaProvider(panel.dataset.source || '');
    if (!button || !provider) return;
    button.hidden = false;
    button.addEventListener(
      'click',
      () => {
        const frame = document.createElement('iframe');
        frame.src = provider.src;
        frame.title = `${provider.name} ${provider.audio ? text.audio : text.video}`;
        frame.allow = 'autoplay; fullscreen; picture-in-picture';
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.allowFullscreen = true;
        frame.className = provider.audio ? 'audio-player' : 'video-player';
        button.replaceWith(frame);
        frame.focus();
        const note = panel.querySelector('[data-player-note]');
        if (note) note.textContent = text.loaded;
      },
      { once: true },
    );
  }
  document.querySelectorAll<HTMLElement>('[data-player]').forEach(activate);
  document.querySelectorAll<HTMLAnchorElement>('.prose a[href]').forEach((link) => {
    const provider = mediaProvider(link.href);
    if (!provider || link.querySelector('img')) return;
    const promoted = [...document.querySelectorAll<HTMLElement>('[data-player][id]')].find(
      (panel) => panel.dataset.source === provider.src,
    );
    if (promoted) {
      link.href = `#${promoted.id}`;
      link.textContent = text.above;
      return;
    }
    const panel = document.createElement('div');
    panel.className = 'media-panel';
    panel.dataset.source = provider.src;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'button button-dark';
    button.dataset.play = '';
    button.textContent = `▶ ${provider.audio ? text.audio : text.video}`;
    const note = document.createElement('p');
    note.dataset.playerNote = '';
    note.textContent = text.note;
    link.before(panel);
    panel.append(button, note, link);
    link.textContent = `${text.open} ${provider.name} ↗`;
    activate(panel);
  });
</script>
