---
import { url } from '../lib/content';
---

<div class="site-preferences" translate="no">
  <details class="language-picker">
    <summary aria-label="Language / Idioma">
      <span data-current-language>ES</span>
      <span aria-hidden="true">⌄</span>
    </summary>
    <div class="language-options">
      <a href={url('/')} data-language="es" lang="es" hreflang="es">
        Español <span>ES</span>
      </a>
      <a href={url('/en/')} data-language="en" lang="en" hreflang="en">
        English <span>EN</span>
      </a>
    </div>
  </details>
  <button class="theme-toggle" type="button" aria-label="Tema oscuro" aria-pressed="false" hidden>
    <svg
      class="moon-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden="true"
    >
      <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
    </svg>
    <svg
      class="sun-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>
</div>
<script>
  const picker = document.querySelector<HTMLDetailsElement>('.language-picker');
  const language = document.documentElement.lang === 'es' ? 'es' : 'en';
  document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
    const syncDestination = () => {
      const target = new URL(link.href);
      target.search = location.search;
      // Explicit links still work when the browser blocks local storage.
      target.searchParams.set('lang', link.dataset.language!);
      target.hash = location.hash;
      link.href = target.href;
    };
    syncDestination();
    link.addEventListener('click', () => {
      syncDestination();
      try {
        localStorage.setItem('saturdays-language', link.dataset.language!);
      } catch {}
    });
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !picker?.contains(event.target) && picker)
      picker.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && picker?.open) {
      picker.open = false;
      picker.querySelector('summary')?.focus();
    }
  });
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const system = matchMedia('(prefers-color-scheme: dark)');
  function applyTheme(dark: boolean) {
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    button?.setAttribute('aria-pressed', String(dark));
    button?.setAttribute('aria-label', language === 'es' ? 'Tema oscuro' : 'Dark theme');
    button?.setAttribute(
      'title',
      language === 'es'
        ? dark
          ? 'Cambiar a tema claro'
          : 'Cambiar a tema oscuro'
        : dark
          ? 'Switch to light theme'
          : 'Switch to dark theme',
    );
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', dark ? '#10172c' : '#ffffff');
  }
  if (button) {
    button.hidden = false;
    applyTheme(document.documentElement.dataset.theme === 'dark');
    button.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      applyTheme(dark);
      try {
        localStorage.setItem('saturdays-theme', dark ? 'dark' : 'light');
      } catch {}
    });
  }
  system.addEventListener('change', () => {
    let saved;
    try {
      saved = localStorage.getItem('saturdays-theme');
    } catch {}
    if (!saved) applyTheme(system.matches);
  });
</script>
