---
import type { CollectionEntry } from 'astro:content';
import { url, dateLabel, readingTime } from '../lib/content';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { episodeInfo } from '../lib/media.mjs';
interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
  heading?: 'h2' | 'h3';
  filterCategory?: string;
}
const { post, featured = false, heading: Heading = 'h3', filterCategory } = Astro.props;
const p = post.data;
const episode = p.category === 'Podcast' ? episodeInfo(p.title) : null;
---

<article
  class:list={['post-card', { featured }]}
  data-year={String(p.pubDate.getUTCFullYear())}
  data-post
  data-category={filterCategory || p.category}
  data-search={`${p.title} ${p.description} ${p.author} ${p.tags.join(' ')}`.toLocaleLowerCase()}
>
  <a class="post-image" href={url(p.legacyPath)} tabindex="-1" aria-hidden="true">
    {p.image ? (
      <ResponsiveImage
        src={p.image}
        alt=""
        sizes="(max-width: 580px) calc(100vw - 36px), (max-width: 1000px) 44vw, 390px"
      />
    ) : (
      <div class="image-placeholder">
        <Icon name="spark" size={80} />
      </div>
    )}
    <span class="image-arrow">
      <Icon name="northeast" size={23} />
    </span>
  </a>
  <div class="post-content">
    <div class="post-meta">
      <span class="tag">{p.category}</span>
      <span data-reading-minutes={p.category !== 'Podcast' ? readingTime(post.body) : undefined}>
        {p.category === 'Podcast'
          ? episode
            ? `Season ${episode.season} / Episode ${episode.episode}`
            : 'Listen to the episode'
          : `${readingTime(post.body)} min read`}
      </span>
    </div>
    <Heading class="post-title" lang={p.language}>
      <a href={url(p.legacyPath)}>{p.title}</a>
    </Heading>
    {featured && <p lang={p.language}>{p.description}</p>}
    <div class="post-byline">
      <span>{p.author}</span>
      <time datetime={p.pubDate.toISOString()}>{dateLabel(p.pubDate)}</time>
    </div>
  </div>
</article>
