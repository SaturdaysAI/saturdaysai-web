---
import Icon from './Icon.astro';
import { url } from '../lib/content';
import courseData from '../data/courses.json';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const course = courseData.courses.find((item) => item.topic === 'AI Safety / Security');
if (!course) throw new Error('The AI safety introduction must be listed in the course catalogue.');
---

<section class:list={['safety-spotlight', { compact }]} aria-labelledby="safety-heading">
  <div class="safety-orbit" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="safety-intro">
    <span class="eyebrow">AI SAFETY / SECURITY</span>
    <h2 id="safety-heading">
      Build the future.
      <br />
      <span>Protect what matters.</span>
    </h2>
    <p>
      The next breakthrough should move us forward. Learn to question what an AI system can do,
      recognise where it can fail and build safeguards for the people it affects.
    </p>
  </div>
  <ol class="safety-principles">
    <li>
      <span class="safety-number">01</span>
      <div>
        <h3>Understand the risks</h3>
        <p>From harmful mistakes and misuse to loss of control.</p>
      </div>
    </li>
    <li>
      <span class="safety-number">02</span>
      <div>
        <h3>Test the evidence</h3>
        <p>Evaluate capabilities, limitations and behaviour before trusting a system.</p>
      </div>
    </li>
    <li>
      <span class="safety-number">03</span>
      <div>
        <h3>Design safeguards</h3>
        <p>Combine oversight, access controls and practical mitigations.</p>
      </div>
    </li>
  </ol>
  <div class="safety-action">
    <div>
      <span class="safety-course-label">A PLACE TO START</span>
      <h3>Introduction to AI Safety</h3>
      <p>Course taught in Spanish on cursos.saturdays.ai.</p>
    </div>
    <div class="safety-links">
      <a class="button button-orange" href={course.url}>
        Explore the introductory course <Icon name="northeast" size={18} />
      </a>
      <a class="safety-more" href={url('/seguridad-ia/')}>
        Explore AI Safety / Security <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .safety-spotlight {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 48px 0 72px;
    padding: clamp(26px, 5vw, 64px);
    border: 1px solid #465174;
    border-radius: 28px;
    background: #151e3b;
    color: #f7f8ff;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 36px 60px;
  }
  .safety-spotlight .eyebrow {
    color: #ffad72;
    letter-spacing: 0.14em;
  }
  .safety-intro h2 {
    font-size: clamp(2rem, 3.7vw, 3.6rem);
    line-height: 1.13;
    letter-spacing: -0.055em;
    margin: 20px 0;
  }
  .safety-intro h2 span {
    color: #ffad72;
  }
  .safety-intro > p {
    font-size: 1rem;
    line-height: 1.8;
    max-width: 52ch;
    color: #d8dff1;
  }
  .safety-principles {
    list-style: none;
    padding: 10px 0 0;
    margin: 0;
    display: grid;
    gap: 24px;
    align-content: center;
  }
  .safety-principles li {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .safety-number {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid #657297;
    border-radius: 50%;
    color: #ffad72;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .safety-principles h3 {
    font-size: 1.02rem;
    margin: 0 0 6px;
    color: #fff;
  }
  .safety-principles p {
    font-size: 0.88rem;
    line-height: 1.65;
    margin: 0;
    color: #d8dff1;
  }
  .safety-action {
    grid-column: 1/-1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 26px;
    border-top: 1px solid #465174;
    padding-top: 30px;
  }
  .safety-course-label {
    font-size: 0.67rem;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: #b6c9ee;
  }
  .safety-action h3 {
    font-size: 1.25rem;
    margin: 8px 0;
    color: #fff;
  }
  .safety-action p {
    font-size: 0.8rem;
    color: #d8dff1;
    margin: 0;
    line-height: 1.6;
  }
  .safety-links {
    display: grid;
    gap: 16px;
    justify-items: start;
    flex: none;
  }
  .safety-links .button {
    max-width: 100%;
    white-space: normal;
    line-height: 1.45;
    min-height: 48px;
  }
  .safety-more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f6f8ff;
    font-size: 0.82rem;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .safety-more:hover {
    color: #ffad72;
  }
  .safety-spotlight a:focus-visible {
    outline: 3px solid #ffbc8c;
    outline-offset: 5px;
  }
  .safety-orbit {
    position: absolute;
    z-index: -1;
    inset: -130px -170px auto auto;
    width: 520px;
    height: 520px;
    opacity: 0.11;
    pointer-events: none;
    transform: rotate(-22deg);
  }
  .safety-orbit span {
    position: absolute;
    border: 1px solid #ffad72;
    border-radius: 50%;
    inset: 0;
  }
  .safety-orbit span:nth-child(2) {
    inset: 60px;
  }
  .safety-orbit span:nth-child(3) {
    inset: 120px;
  }
  .compact {
    display: block;
    margin: 0 0 40px;
    padding: 30px 36px;
  }
  .compact .safety-intro h2 {
    font-size: 2rem;
    margin: 12px 0 24px;
  }
  .compact .safety-intro > p,
  .compact .safety-principles {
    display: none;
  }
  .compact .safety-intro br {
    display: none;
  }
  .compact .safety-intro h2 span::before {
    content: ' ';
  }
  @media (max-width: 900px) {
    .safety-spotlight {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .safety-action {
      align-items: flex-start;
      flex-direction: column;
    }
    .safety-links {
      width: 100%;
      flex: initial;
    }
  }
  @media (max-width: 540px) {
    .safety-spotlight {
      margin: 32px 0 48px;
      border-radius: 20px;
      padding: 26px 22px;
    }
    .safety-intro h2 {
      font-size: 2.15rem;
    }
    .safety-links .button {
      width: 100%;
      justify-content: space-between;
      font-size: 0.8rem;
    }
    .safety-principles {
      gap: 22px;
    }
  }
</style>
