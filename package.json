{
  "name": "saturdaysai-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "assets": "node scripts/prepare-images.mjs && node scripts/prepare-social-cards.mjs",
    "predev": "npm run assets",
    "precheck": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build && node scripts/verify-build.mjs && node scripts/verify-performance.mjs && node scripts/verify-social-cards.mjs",
    "import:pilot": "node scripts/import-pilot.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/montserrat": "^5.3.0",
    "astro": "7.4.2",
    "marked": "18.1.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/sanitize-html": "^2.16.0",
    "cheerio": "^1.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
